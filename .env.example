# Copiez ce fichier vers .env.local (git-ignoré) et renseignez les valeurs réelles.
# Ne commitez jamais de vrai secret dans le dépôt.

# Authentification / progression (Postgres, Neon recommandé — https://neon.tech,
# offre gratuite suffisante pour une V1). Sur le tableau de bord Neon : Project >
# Connection Details > "Pooled connection" (le driver HTTP utilisé ici,
# @neondatabase/serverless, fonctionne aussi bien avec la variante non-poolée,
# mais la poolée est recommandée par défaut sur Vercel).
# Format : postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# Une fois DATABASE_URL renseigné, appliquez le schéma une fois :
#   npm run db:migrate
# (ou collez le contenu de lib/auth/schema.sql dans l'éditeur SQL de Neon)

# Email transactionnel (réinitialisation de mot de passe) — Resend,
# https://resend.com : voir lib/auth/mailer.ts. Sans RESEND_API_KEY et
# AUTH_EMAIL_FROM, le lien de réinitialisation est simplement journalisé en
# console (mode développement) au lieu d'être réellement envoyé — jamais de
# faux succès en production, où l'envoi échoue explicitement si l'un des
# deux manque.
# Clé API du tableau de bord Resend (Dashboard > API Keys).
RESEND_API_KEY=
# Adresse expéditrice, ex. "ParcoursFR <noreply@votredomaine.fr>" — le
# domaine doit être vérifié dans Resend (Dashboard > Domains) pour envoyer à
# n'importe quel destinataire ; sans domaine vérifié, Resend n'autorise
# l'envoi qu'à l'adresse email du compte Resend lui-même.
AUTH_EMAIL_FROM=

# Origine publique de l'application, utilisée pour construire le lien de
# réinitialisation envoyé par email (voir resolveAppOrigin,
# app/actions/auth.ts) — jamais déduite du header Host de la requête en
# production, pour ne pas laisser un client falsifier le domaine du lien
# envoyé. Optionnel : à défaut, la valeur VERCEL_URL fournie automatiquement
# par Vercel est utilisée. Sans domaine personnalisé, ce n'est donc requis
# que si vous voulez forcer une URL canonique précise.
# Format : https://votredomaine.fr (sans slash final)
NEXT_PUBLIC_APP_URL=

# Paiement (Stripe) — voir lib/commerce/stripe.ts
# Sans ces variables, /api/checkout répond 503 (pas de fausse intégration).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Nécessaire pour que le webhook active réellement le premium après paiement
# (voir app/api/webhooks/stripe/route.ts). En local : `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` affiche le secret whsec_... à utiliser ici.
# En production, à configurer aussi côté Stripe Dashboard sur les événements
# checkout.session.completed, customer.subscription.updated et .deleted.
STRIPE_WEBHOOK_SECRET=
