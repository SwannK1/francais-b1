# Paiement (Stripe) — voir lib/commerce/stripe.ts
# Sans ces variables, /api/checkout répond 503 (pas de fausse intégration).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Nécessaire pour que le webhook active réellement le premium après paiement
# (voir app/api/webhooks/stripe/route.ts). En local : `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` affiche le secret whsec_... à utiliser ici.
# En production, à configurer aussi côté Stripe Dashboard sur les événements
# checkout.session.completed, customer.subscription.updated et .deleted.
STRIPE_WEBHOOK_SECRET=

# Authentification / base de comptes (node:sqlite) — voir lib/auth/db.ts.
# Chemin du fichier SQLite. Sur une plateforme serverless au système de
# fichiers éphémère (ex. Vercel), pointer vers un volume persistant — sinon
# les comptes créés disparaissent au redéploiement.
AUTH_DB_PATH=data/app.db
